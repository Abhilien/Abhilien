# Copy to .env and fill in. Never commit the real .env.

# Claude (the agent brain). An `ant auth login` profile also works instead of a key.
ANTHROPIC_API_KEY=

# Image generation: "mock" (offline placeholders, free) or "replicate".
IMAGE_PROVIDER=mock
REPLICATE_API_TOKEN=
# Any Replicate text-to-image model, owner/name. Pick one that supports a reference
# image if you want a consistent face (see docs/CONSISTENT_FACES.md).
REPLICATE_MODEL=black-forest-labs/flux-1.1-pro
# Input field the model uses for a reference/identity image (leave blank if none).
REPLICATE_REFERENCE_FIELD=

# Instagram Graph API (Business/Creator account linked to a Facebook Page).
# One token + IG user id per persona, keyed by persona slug in upper case, e.g.
#   IG_TOKEN_LUNA_VOSS=...   IG_USER_ID_LUNA_VOSS=...
GRAPH_API_HOST=https://graph.facebook.com
GRAPH_API_VERSION=v21.0

# Instagram fetches images from a public URL. If your image provider returns
# local files, upload ./media somewhere public (S3, R2, a CDN) and set its base URL.
MEDIA_PUBLIC_BASE_URL=

# Safety rail: nothing is posted for real unless this is "true" AND you pass --live.
ALLOW_LIVE_PUBLISH=false
